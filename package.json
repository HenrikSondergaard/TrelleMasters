{
  "name": "trellemasters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sass css/src/main.scss css/style.css --no-source-map --style=expanded",
    "build:watch": "sass --watch css/src/main.scss css/style.css --no-source-map --style=expanded",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js/"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "sass": "^1.101.0",
    "vitest": "^4.0.0"
  }
}
